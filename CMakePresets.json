{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Native (Debug) - desktop Qt, tests",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/build/christmasreckoning/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.12.0/gcc_64",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native (Release)",
      "inherits": "native-debug",
      "binaryDir": "$env{HOME}/build/christmasreckoning/native-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly (single-threaded, MinSizeRel)",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/build/christmasreckoning/wasm-release",
      "toolchainFile": "$env{HOME}/Qt/6.12.0/wasm_singlethread/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "QT_HOST_PATH": "$env{HOME}/Qt/6.12.0/gcc_64",
        "CR_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "wasm-release", "configurePreset": "wasm-release" }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    }
  ]
}
